<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewNombrePersona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textStyle="bold"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/textViewDescripcionPersona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/textViewMontoOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monto original: $0.00"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/textViewMontoPendiente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monto pendiente: $0.00"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/textViewEstadoDeuda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textStyle="bold"
            android:textColor="@android:color/holo_green_dark"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historial de abonos"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAbonos"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar nuevo abono"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <!-- Botón expansor -->
        <Button
            android:id="@+id/buttonExpandirAbono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar abono"/>

        <!-- Formulario ocultable -->
        <LinearLayout
            android:id="@+id/layoutFormularioAbono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/editTextMontoAbono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Monto"
                android:inputType="numberDecimal"/>

            <EditText
                android:id="@+id/editTextNotaAbono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nota (opcional)"/>

            <Spinner
                android:id="@+id/spinnerCuentaAbono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/buttonConfirmarAbono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirmar abono"/>
        </LinearLayout>

        <Button
            android:id="@+id/buttonLiquidarDeuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Liquidar deuda/acreencia"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView> 