<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <EditText
        android:id="@+id/editTextNombreProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del producto"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/editTextCantidadProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Cantidad"
            android:inputType="numberDecimal"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/editTextUnidadProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Unidad (litros, kg, etc.)"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/editTextPrecioCompra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Precio de compra"
            android:inputType="numberDecimal"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/buttonCalculatorCompra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧮"
            android:textSize="18sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/editTextPrecioVentaDefinido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Precio de venta"
            android:inputType="numberDecimal"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/buttonCalculatorVentaDefinido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧮"
            android:textSize="18sp"/>

    </LinearLayout>

    <Spinner
        android:id="@+id/spinnerMonedaProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cuenta para ganancia (opcional)"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spinnerCuentaGanancia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cuenta para venta (opcional)"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spinnerCuentaVenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cuenta para rebajar el gasto (opcional)"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spinnerCuentaProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@android:color/darker_gray"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/textViewAgregarStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agregar stock adicional (opcional)"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/layoutAgregarStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/editTextCantidadAdicional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cantidad adicional"
            android:inputType="numberDecimal"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/editTextPrecioCompraAdicional"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Precio compra adicional"
                android:inputType="numberDecimal"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/buttonCalculatorCompraAdicional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧮"
                android:textSize="18sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/editTextPrecioVentaAdicional"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Precio venta adicional"
                android:inputType="numberDecimal"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/buttonCalculatorVentaAdicional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧮"
                android:textSize="18sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/textViewInfoRecalculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Los precios se recalcularán con el promedio ponderado"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"/>

    </LinearLayout>

</LinearLayout>
</ScrollView>