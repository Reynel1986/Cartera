<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@android:color/white"
    android:layout_marginBottom="2dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewNombreProducto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/textViewCantidadProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 u"
                android:textSize="12sp"
                android:textColor="@android:color/holo_blue_dark"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/textViewPrecioCompra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C: $0.00 | V: $0.00"
            android:textSize="11sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/textViewGanancia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gan: $0.00 | Ven: $0.00"
            android:textSize="11sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="1dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="8dp">

        <Button
            android:id="@+id/buttonVenderProducto"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Vender"
            android:textSize="11sp"
            android:background="@android:color/holo_green_dark"
            android:textColor="@android:color/white"
            android:layout_marginEnd="4dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"/>

        <Button
            android:id="@+id/buttonEditProducto"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Editar"
            android:textSize="11sp"
            android:background="@android:color/holo_blue_dark"
            android:textColor="@android:color/white"
            android:layout_marginEnd="4dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"/>

        <ImageButton
            android:id="@+id/buttonDeleteProducto"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Eliminar producto"
            android:tint="@android:color/holo_red_dark"
            android:focusable="false"
            android:clickable="true"
            android:padding="4dp"/>

    </LinearLayout>

</LinearLayout> 