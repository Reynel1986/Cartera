<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <TextView
        android:id="@+id/textViewProductoInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Información del producto"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/editTextCantidadVender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cantidad a vender"
        android:inputType="numberDecimal"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/editTextPrecioVentaReal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Precio venta real"
            android:inputType="numberDecimal"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/buttonCalculatorVentaReal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧮"
            android:textSize="18sp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/textViewPrecioPlaneado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Precio planeado: $0.00"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/editTextFechaVenta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Fecha de venta"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/buttonDatePickerVenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅"
            android:textSize="18sp"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cuenta destino:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <Spinner
        android:id="@+id/spinnerCuentaDestino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/textViewTotalVenta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total de la venta: $0.00"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@android:color/holo_green_dark"
        android:layout_marginTop="8dp"/>

</LinearLayout> 
</ScrollView>